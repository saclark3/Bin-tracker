rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Each person's own profile: name and which household they're in.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes map to a household. Look-up by exact code only (no listing).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Members can edit. A non-member can only add themselves, and only with the right invite code.
      allow update: if isMember(hid) || (
        signedIn() &&
        request.resource.data.joinCode == resource.data.inviteCode &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode']) &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.auth.uid in request.resource.data.members
      );

      // Areas, spots, bins, items and access history: members only.
      match /{collection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
